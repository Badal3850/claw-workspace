{
  "agents": {
    "defaults": {
      "workspace": "~/.openclaw/workspace",
      "models": {
        "google/gemini-2.5-flash-lite": {
          "alias": "Gemini Flash-Lite Free"
        },
        "google/gemini-2.5-flash": {
          "alias": "Gemini Flash Free"
        },
        "openrouter/openrouter/free": {
          "alias": "OpenRouter Free Router"
        },
        "openrouter/deepseek/deepseek-v4-flash:free": {
          "alias": "DeepSeek V4 Free"
        }
      },
      "model": {
        "primary": "google/gemini-2.5-flash-lite",
        "fallbacks": [
          "google/gemini-2.5-flash",
          "openrouter/openrouter/free",
          "openrouter/deepseek/deepseek-v4-flash:free"
        ]
      },
      "heartbeat": {
        "every": "30m",
        "model": "google/gemini-2.5-flash"
      },
      "subagents": {
        "model": "google/gemini-2.5-flash"
      },
      "memorySearch": {
        "provider": "gemini",
        "enabled": true,
        "model": "gemini-embedding-001"
      }
    }
  },
  "gateway": {
    "mode": "local",
    "auth": {
      "mode": "token",
      "token": "__RUN_openclaw_doctor_--generate-gateway-token__"
    },
    "port": 7860,
    "bind": "lan",
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    },
    "controlUi": {
      "allowInsecureAuth": false
    },
    "nodes": {
      "denyCommands": [
        "camera.snap",
        "camera.clip",
        "screen.record",
        "contacts.add",
        "calendar.add",
        "reminders.add",
        "sms.send",
        "sms.search"
      ]
    }
  },
  "models": {
    "providers": {
      "google": {
        "api": "google-generative-ai",
        "models": [
          {
            "id": "gemini-2.5-flash-lite",
            "name": "Gemini 2.5 Flash-Lite"
          },
          {
            "id": "gemini-2.5-flash",
            "name": "Gemini 2.5 Flash"
          }
        ]
      },
      "openrouter": {
        "models": [
          {
            "id": "openrouter/free",
            "name": "OpenRouter Free Router"
          },
          {
            "id": "deepseek/deepseek-v4-flash:free",
            "name": "DeepSeek V4 Flash Free"
          }
        ]
      }
    }
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "tools": {
    "profile": "coding"
  },
  "plugins": {
    "entries": {
      "openrouter": {
        "enabled": true
      },
      "telegram": {
        "enabled": true
      },
      "google": {
        "enabled": true
      }
    }
  },
  "auth": {
    "profiles": {
      "google:free1": {
        "provider": "google",
        "mode": "api_key"
      },
      "openrouter:free1": {
        "provider": "openrouter",
        "mode": "api_key"
      }
    },
    "order": {
      "google": [
        "google:free1"
      ],
      "openrouter": [
        "openrouter:free1"
      ]
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "groups": {
        "*": {
          "requireMention": true
        }
      }
    },
    "discord": {
      "enabled": false,
      "dmPolicy": "pairing",
      "groupPolicy": "allowlist"
    }
  }
}
