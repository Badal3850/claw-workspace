# OpenClaw internal state
.openclaw/

# Sensitive files — never commit these
*.env
.env.*

# OS files
Thumbs.db
.DS_Store

# Temp files
*.bak
*.swp
*.tmp

# Dependencies
node_modules/

# Generated runtime config (may contain local deployment details)
openclaw.json

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
